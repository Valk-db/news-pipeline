# Database (Supabase/Neon)
# Supabase (DIRECT - IPv6 only, may fail in CI): postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Supabase (POOLER - IPv4 compatible, RECOMMENDED): postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Neon:     postgresql+asyncpg://[USER]:[PASSWORD]@[HOST]/[DBNAME]?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# Groq primary — configurable, no card, ongoing free tier
GROQ_API_KEY=your_groq_key
GROQ_MODEL=openai/gpt-oss-20b       # 30 RPM, 1K RPD, 8K TPM, 200K TPD
# Alternative: qwen/qwen3.8-27b — same limits, NOT qwen3-32b (gone)
# llama-3.1-8b-instant and llama-3.3-70b-versatile are Enterprise-only now — don't use either

# Cerebras backup — free-tier terms unconfirmed even from their own docs, check at signup
# Backup-only, so this doesn't block anything either way
CEREBRAS_API_KEY=your_cerebras_key
CEREBRAS_MODEL=gpt-oss-120b

# Reddit (public RSS, no credentials required; UA is a courtesy, not auth)
REDDIT_USER_AGENT=news-pipeline/0.1 by your_username

# YouTube (optional, for later)
YOUTUBE_API_KEY=your_youtube_key

# Optional: Supabase URL for direct access
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# RSS fetch tuning. Production defaults are 10 concurrent feed fetches and a
# 30s per-feed timeout; do not change them for production runs. A dev run
# (`python -m src.ingestion.run --env dev`) applies RSS_FETCH_CONCURRENCY=25 and
# RSS_FETCH_TIMEOUT=15 on top of these, because dev ingests crawl through the
# egress proxy. Set either variable here (or in .env.dev) to override the dev
# default for your machine; an explicit value always wins.
# RSS_FETCH_CONCURRENCY=10
# RSS_FETCH_TIMEOUT=30

# Curation UI Basic Auth (required for any public deployment)
CURATION_USER=your_username
CURATION_PASSWORD=your_secure_password

# Transparency: operator-published public keys the /proof/{id} page verifies
# checkpoint signatures against. JSON object: {"<key_id>": {"algorithm":
# "ed25519", "public_key": "<64 hex chars of the raw 32-byte public key>"}}.
# Only ed25519 keys are admitted; HMAC entries are ignored with a warning
# (an HMAC proves nothing to a third party). While this is empty, every proof
# honestly renders "signature unverified" instead of claiming a signed log.
# Generate a keypair with the optional `cryptography` package installed:
#   python -c "from src.transparency.checkpoint import generate_ed25519_signer;
#   s=generate_ed25519_signer(); print(s.key_id, s.public_key_bytes().hex())"
# Keep the private key offline; publish only the public half here.
# TRANSPARENCY_TRUSTED_KEYS={"2026-operator-1": {"algorithm": "ed25519", "public_key": "<64 hex chars>"}}